<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>


@if (showingSummary)
{
    <div class="summary-screen">
        <h2>Nivån är slut. Här är dina val:</h2>
        <ul>
            @foreach (var entry in session.ChoiceHistory)
            {
                <li>@entry</li>
            }
        </ul>
        <button @onclick="ContinueToNextLevel">Fortsätt till nästa kapitel</button>
    </div>
}
else
{
    <div class="story-screen">
        <p>@currentStoryText</p>
        @foreach (var choice in currentChoices)
        {
            <button @onclick="() => HandleChoice(choice)">@choice.ButtonText</button>
        }
    </div>
}

@code {
    bool showingSummary = false;
    GameSession session = new GameSession();

    void HandleChoice(Choice choice)
    {
        // Logga valet för sammanfattningen
        if (!string.IsNullOrEmpty(choice.SummaryText))
        {
            session.ChoiceHistory.Add(choice.SummaryText);
        }

        if (choice.EndsLevel)
        {
            showingSummary = true;
            session.SaveCheckpoint(); // Spara inför nästa nivå
        }
        else
        {
            session.CurrentNodeId = choice.NextNodeId;
            // Här hämtar ni nästa text/val från er databas/lista
        }
    }

    void ContinueToNextLevel()
    {
        showingSummary = false;
        // Rensa historiken om ni bara vill visa val per nivå,
        // eller behåll den för en slutresumé.
    }
}