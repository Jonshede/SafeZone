@inject HttpClient Http
@using SafeZone.Models

@inherits LayoutComponentBase
@inject HttpClient Http

<main>
    @Body
</main>

@code {
    private SafeZone.Models.GameScenario? levelData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            levelData = await Http.GetFromJsonAsync<SafeZone.Models.GameScenario>("game-data/level1.json");
        }
        catch
        {
            // Ignore load errors so the layout still renders
        }
    }
}