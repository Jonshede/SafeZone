// HttpClient är förinställd att titta i wwwroot som startpunkt
@inject HttpClient Http
@using SafeZone.Models

@code {
    private GameScenario levelData;

    protected override async Task OnInitializedAsync()
    {
        // Här hämtar vi filen från wwwroot
        levelData = await Http.GetFromJsonAsync<GameScenario>("game-data/level1.json");
    }
}