@inherits LayoutComponentBase
@inject HttpClient Http
@inject IJSRuntime JS

<main @onclick="TryStartMusic">
    @* Persistent ljudspelare som täcker hela spelet *@
    <audio id="gameMusic" loop>
        <source src="/audio/game-theme.mp3" type="audio/mpeg">
    </audio>

    <audio id="gameOverSound">
        <source src="/audio/game-over.mp3" type="audio/mpeg">
    </audio>

    @Body
</main>

@code {
    private bool _musicStarted = false;

    private async Task TryStartMusic()
    {
        // Startar musiken vid första klicket på skärmen
        if (!_musicStarted)
        {
            try
            {
                await JS.InvokeVoidAsync("playAudio", "gameMusic");
                _musicStarted = true;
            }
            catch
            {
                // Ignorera om JavaScript inte är redo än
            }
        }
    }

    // Om du behöver ladda levelData i layouten behåller vi detta,
    // annars kan du ta bort HttpClient och OnInitialized härifrån.
    private SafeZone.Models.GameScenario? levelData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            levelData = await Http.GetFromJsonAsync<SafeZone.Models.GameScenario>("game-data/level1.json");
        }
        catch
        {
            // Ignore load errors
        }
    }
}