@page "/"
@inject NavigationManager Nav

<div class="game-wrapper">
    <img src="images/start-bg.jpg" class="image-bg" alt="Start bg" />

    <div class="start-content">
        <h1 class="title">SAFEZONE</h1>
        <div class="divider"></div>
        <p class="subtitle">How do you act?</p>

        <button class="btn-start" @onclick="StartGame">
            [ Start your adventure ]
        </button>
    </div>
</div>

@code {
    void StartGame() => Nav.NavigateTo("/play");
}