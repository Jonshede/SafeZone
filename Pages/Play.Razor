@page "/play"
@using SafeZone.Models
@using SafeZone.Logic
@inject HttpClient Http
@inject GameStateService State
@implements IDisposable

<div class="game-container">
    @if (currentScenario == null)
    {
        <div class="loading-box">
            <p>Laddar berättelsen...</p>
        </div>
    }
    else
    {
        <div class="scenario-box">
            <h1>@currentLevel?.LevelName</h1>
            <p class="scenario-text">@currentScenario.Text</p>

            <div class="choices-list">
                @foreach (var choice in currentScenario.Choices)
                {
                    <button class="choice-button" @onclick="() => OnChoiceSelected(choice)">
                        @choice.ButtonText
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    private GameLevel? currentLevel;
    private GameScenario? currentScenario;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;

        try
        {
            // Load the level file from wwwroot/game-data/level1.json
            currentLevel = await Http.GetFromJsonAsync<GameLevel>("game-data/level1.json");

            if (currentLevel != null)
            {
                // Ensure state has a valid start node (optional)
                if (string.IsNullOrEmpty(State.CurrentNodeId))
                {
                    State.CurrentNodeId = currentLevel.StartNodeId;
                }
                UpdateActiveScenario();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading level: {ex.Message}");
        }
    }

    private void OnChoiceSelected(GameChoice choice)
    {
        State.HandleChoice(choice);
        UpdateActiveScenario();
    }

    private void UpdateActiveScenario()
    {
        if (currentLevel != null)
        {
            currentScenario = currentLevel.Scenarios
                .FirstOrDefault(s => s.Id == State.CurrentNodeId);
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}