@page "/play"
@using SafeZone.Models
@using SafeZone.Logic
@inject GameEngine Engine
@inject GameStateService State
@inject NavigationManager Nav
@implements IDisposable

<div class="game-wrapper">
    @* DYNAMISK BAKGRUND: Byter bild baserat på scenariot, annars default *@
    @if (currentScenario != null && !string.IsNullOrEmpty(currentScenario.ImagePath))
    {
        <img src="@currentScenario.ImagePath" class="image-bg" alt="Scene Background" />
    }
    else
    {
        @* Fallback-bild om ImagePath saknas i JSON *@
        <img src="images/start-bg.jpg" class="image-bg" alt="Default Background" />
    }

    @if (currentScenario == null)
    {
        @* LOADING SCREEN *@
        <div class="start-content">
            <h1 class="title">INITIALIZING...</h1>
            <div class="divider"></div>
            <p class="subtitle">Fetching tactical data from the grid</p>
        </div>
    }
    else
    {
        @* SPEL-INTERFACE *@
        <div class="content-box">
            @* Nivåns namn som en liten rubrik *@
            <h2 style="color: #ff4e00; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 2px;">
                @currentLevel?.LevelName
            </h2>
            <div class="divider" style="width: 100px; margin: 0 auto 1.5rem auto;"></div>
            
            @* Själva berättelsetexten *@
            <p class="scenario-text">
                @currentScenario.Text
            </p>

            @* Valmöjligheter *@
            <div class="choices-list d-flex flex-wrap justify-content-center">
                @foreach (var choice in currentScenario.Choices)
                {
                    <button class="btn-safezone" @onclick="() => OnChoiceSelected(choice)">
                        [ @choice.ButtonText ]
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Prenumerera på ändringar i statet
        State.OnChange += StateHasChanged;

        try
        {
            // Hämtar JSON-filen. Dubbelkolla att mappen heter 'game-data' i wwwroot
            currentLevel = await Http.GetFromJsonAsync<GameLevel>("game-data/level1.json");

            if (!string.IsNullOrEmpty(State.CurrentNodeId))
            {
                // Om vi precis startat spelet, sätt CurrentNodeId till start-noden från JSON
                if (string.IsNullOrEmpty(State.CurrentNodeId) || State.CurrentNodeId == "Start")
                {
                    State.CurrentNodeId = currentLevel.StartNodeId;
                }
                
                UpdateActiveScenario();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading level data: {ex.Message}");
        }
    }

    private async Task OnChoiceSelected(GameChoice choice)
    {
        // Uppdatera historik och ID via tjänsten
        State.HandleChoice(choice);
        
        // Uppdatera vad som visas på skärmen
        UpdateActiveScenario();
    }

            var qNextLevel = Uri.EscapeDataString(choice.NextLevel);
            var qNextNode = Uri.EscapeDataString(choice.NextNodeId ?? string.Empty);
            Nav.NavigateTo($"/summary?nextLevel={qNextLevel}&nextNode={qNextNode}");
            return;
        }

        // otherwise handle same-level navigation via engine
        await Engine.SelectChoice(choice);

        var ended = Engine.CurrentScenario == null
                    || Engine.CurrentScenario.IsTerminal
                    || (!string.IsNullOrEmpty(choice.NextNodeId) && choice.NextNodeId.StartsWith("end_"));

        if (ended)
        {
            // Hittar det scenario i listan som matchar ID:t vi är på just nu
            currentScenario = currentLevel.Scenarios
                .FirstOrDefault(s => s.Id == State.CurrentNodeId);
        }
    }

    public void Dispose()
    {
        // Städa upp prenumerationen
        State.OnChange -= StateHasChanged;
    }
}