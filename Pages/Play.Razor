@page "/play"
@using SafeZone.Models
@using SafeZone.Logic
@inject GameEngine Engine
@inject GameStateService State
@inject NavigationManager Nav
@implements IDisposable

<div class="game-container">
    @if (Engine.CurrentScenario == null)
    {
        <div class="loading-box">
            <p>Laddar berättelsen...</p>
        </div>
    }
    else
    {
        <div class="scenario-box">
            <h1>@Engine.LoadedLevel?.LevelName</h1>
            <p class="scenario-text">@Engine.CurrentScenario.Text</p>

            <div class="choices-list">
                @foreach (var choice in Engine.CurrentScenario.Choices)
                {
                    <button class="choice-button" @onclick="() => OnChoiceSelected(choice)">
                        @choice.ButtonText
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;

        try
        {
            var levelToLoad = string.IsNullOrEmpty(State.CurrentLevelName) ? "level1" : State.CurrentLevelName;
            await Engine.LoadLevel(levelToLoad);

            if (!string.IsNullOrEmpty(State.CurrentNodeId))
            {
                State.SetCurrentNode(State.CurrentNodeId);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ett fel uppstod vid laddning: {ex.Message}");
        }
    }

    private async Task OnChoiceSelected(GameChoice choice)
    {
        // If this choice jumps to another level, record summary and show summary page first
        if (!string.IsNullOrEmpty(choice.NextLevel))
        {
            if (!string.IsNullOrEmpty(choice.SummaryText))
                State.ChoiceHistory.Add(choice.SummaryText);

            var qNextLevel = Uri.EscapeDataString(choice.NextLevel);
            var qNextNode = Uri.EscapeDataString(choice.NextNodeId ?? string.Empty);
            Nav.NavigateTo($"/summary?nextLevel={qNextLevel}&nextNode={qNextNode}");
            return;
        }

        // otherwise handle same-level navigation via engine
        await Engine.SelectChoice(choice);

        var ended = Engine.CurrentScenario == null
                    || Engine.CurrentScenario.IsTerminal
                    || (!string.IsNullOrEmpty(choice.NextNodeId) && choice.NextNodeId.StartsWith("end_"));

        if (ended)
        {
            Nav.NavigateTo("/summary");
            return;
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}