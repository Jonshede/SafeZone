@page "/play"
@inject HttpClient Http
@inject GameStateService State
@implements IDisposable

<div class="game-container">
    @if (GameScenario == null)
    {
        <p>Laddar omgivningen...</p>
    }
    else
    {
        <div class="scenario-box">
            <p class="scenario-text">@currentScenario.Text</p>

            @if (!string.IsNullOrEmpty(currentScenario.ImagePath))
            {
                <img src="@currentScenario.ImagePath" alt="Scenbild" class="game-img" />
            }

            <div class="choices-list">
                @foreach (var choice in currentScenario.Choices)
                {
                    <button class="choice-button" @onclick="() => OnChoiceSelected(choice)">
                        @choice.ButtonText
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    private GameScenario? currentScenario;
    private List<GameScenario> allScenarios = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Prenumerera på uppdateringar
        State.OnChange += StateHasChanged;

        // 2. Ladda in JSON-datan (Här använder vi din wwwroot-fil)
        // Obs: Du kan behöva justera typen beroende på hur din JSON ser ut
        var data = await Http.GetFromJsonAsync<List<GameScenario>>("game-data/level1.json");
        if (data != null)
        {
            allScenarios = data;
            UpdateActiveScenario();
        }
    }

    private void OnChoiceSelected(GameChoice choice)
    {
        // Uppdatera historik och ID i servicen
        State.HandleChoice(choice);

        // Uppdatera den lokala vyn
        UpdateActiveScenario();
    }

    private void UpdateActiveScenario()
    {
        // Hitta rätt scenario i listan baserat på vad som står i GameStateService
        currentScenario = allScenarios.FirstOrDefault(s => s.Id == State.CurrentNodeId);
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}