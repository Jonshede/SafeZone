@page "/play"
@using SafeZone.Models
@using SafeZone.Logic
@inject GameEngine Engine
@inject GameStateService State
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="game-wrapper">
    @if (showGameOver)
    {
        <div class="game-over-overlay">
            <h1 class="game-over-text">GAME OVER</h1>
        </div>
    }

    @* BAKGRUND: Nu "sticky" via Engine *@
    <div class="background-container">
        <img src="@Engine.CurrentBackground" 
             class="image-bg fade-in" 
             alt="Environment"
             onerror="this.src='images/start-bg.jpg';" />
    </div>

    @if (Engine.IsLoading)
    {
        <div class="start-content">
            <h1 class="title">INITIALIZING...</h1>
            <div class="divider"></div>
        </div>
    }
    else if (Engine.CurrentScenario != null && !showGameOver)
    {
        <div class="content-box">
            <h2 style="color: #ff4e00; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 2px;">
                @(Engine.LoadedLevel?.LevelName ?? "MISSION DATA")
            </h2>
            <div class="divider" style="width: 100px; margin: 0 auto 1.5rem auto;"></div>
        
            <p class="scenario-text">
                @Engine.CurrentScenario.Text
            </p>

            <div class="choices-list d-flex flex-wrap justify-content-center">
                @foreach (var choice in Engine.CurrentScenario.Choices)
                {
                    <button class="btn-safezone" @onclick="() => OnChoiceSelected(choice)">
                        [ @choice.ButtonText ]
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool showGameOver = false;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        if (Engine.CurrentScenario == null)
        {
            var levelToLoad = string.IsNullOrEmpty(State.CurrentLevelName) ? "level1" : State.CurrentLevelName;
            await Engine.LoadLevel(levelToLoad);
        }
    }

    private async Task OnChoiceSelected(GameChoice choice)
    {
        // --- FALL A: Avslutningsfasen ---
        if (Engine.CurrentScenario?.IsDead == true)
        {
            Nav.NavigateTo("/summary?isDead=true");
            return;
        }

        // --- FALL B: Själva händelsen ---
        await Engine.SelectChoice(choice);

        if (Engine.CurrentScenario?.IsDead == true)
        {
            // 1. Starta ljudet direkt när vi märker att spelaren dött
            try 
            {
                await JS.InvokeVoidAsync("playAudio", "gameOverSound");
            }
            catch { /* Ignorera om JS inte är redo */ }

            // 2. Kör animationen
            showGameOver = true;
            StateHasChanged();

            await Task.Delay(4000); 

            showGameOver = false; 
            StateHasChanged();
            return; 
        }

        // --- FALL C: Vanligt spel ---
        if (!string.IsNullOrEmpty(choice.NextLevel))
        {
            var qNextLevel = Uri.EscapeDataString(choice.NextLevel);
            var qNextNode = Uri.EscapeDataString(choice.NextNodeId ?? string.Empty);
            Nav.NavigateTo($"/summary?nextLevel={qNextLevel}&nextNode={qNextNode}");
            return;
        }
    }

    // Ta bort den gamla TriggerGameOver() metoden helt för att undvika förvirring!

    public void Dispose() => State.OnChange -= StateHasChanged;
}