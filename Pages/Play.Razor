@page "/play"
@using SafeZone.Models
@using SafeZone.Logic
@inject GameEngine Engine
@inject GameStateService State
@inject NavigationManager Nav
@implements IDisposable

<div class="game-wrapper">
    @* BAKGRUND: Vi använder Engine för att hämta aktuell bild *@
    @if (Engine.CurrentScenario != null && !string.IsNullOrEmpty(Engine.CurrentScenario.ImagePath))
    {
        <img src="@Engine.CurrentScenario.ImagePath" class="image-bg" alt="Scene Background" />
    }
    else
    {
        <img src="images/start-bg.jpg" class="image-bg" alt="Default Background" />
    }

    @if (Engine.IsLoading)
    {
        @* LOADING SCREEN - Visas medan Engine jobbar *@
        <div class="start-content">
            <h1 class="title">INITIALIZING...</h1>
            <div class="divider"></div>
            <p class="subtitle">Choose the right path...</p>
        </div>
    }
    else if (Engine.CurrentScenario != null)
    {
        @* SPEL-INTERFACE - Nu med den centrala strukturen *@
        <div class="content-box">
            @* Vi försöker hämta nivåns namn från Engine om det finns *@
            <h2 style="color: #ff4e00; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 1.2rem; letter-spacing: 2px;">
                REPORT: MISSION DATA
            </h2>
            <div class="divider" style="width: 100px; margin: 0 auto 1.5rem auto;"></div>
            
            <p class="scenario-text">
                @Engine.CurrentScenario.Text
            </p>

            <div class="choices-list d-flex flex-wrap justify-content-center">
                @foreach (var choice in Engine.CurrentScenario.Choices)
                {
                    <button class="btn-safezone" @onclick="() => OnChoiceSelected(choice)">
                        [ @choice.ButtonText ]
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Prenumerera på ändringar
        State.OnChange += StateHasChanged;

        try
        {
            // Vilken nivå ska vi ladda? Fråga State.
            var levelToLoad = string.IsNullOrEmpty(State.CurrentLevelName) ? "level1" : State.CurrentLevelName;
            
            // Använd motorn för att sköta laddningen (renare!)
            await Engine.LoadLevel(levelToLoad);

            // Om vi har ett sparat ID i statet, se till att motorn synkar dit
            if (!string.IsNullOrEmpty(State.CurrentNodeId))
            {
                // Om din Engine har en metod för att sätta scenariot direkt, annars sköter LoadLevel det.
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during initialization: {ex.Message}");
        }
    }

    private async Task OnChoiceSelected(GameChoice choice)
    {
        // 1. Kolla om valet leder till en NY NIVÅ (Level Transition)
        if (!string.IsNullOrEmpty(choice.NextLevel))
        {
            if (!string.IsNullOrEmpty(choice.SummaryText))
                State.AddChoiceSummary(choice.SummaryText); // <--- minimal change

            var qNextLevel = Uri.EscapeDataString(choice.NextLevel);
            var qNextNode = Uri.EscapeDataString(choice.NextNodeId ?? string.Empty);
            
            // Skicka spelaren till sammanfattningen innan nästa nivå börjar
            Nav.NavigateTo($"/summary?nextLevel={qNextLevel}&nextNode={qNextNode}");
            return;
        }

        // 2. Hantera vanliga val inom samma nivå via motorn
        Engine.SelectChoice(choice);

        // 3. Kolla om spelet tog slut här (Terminal-nod eller ID som börjar på 'end_')
        var isEnd = Engine.CurrentScenario == null 
                    || (!string.IsNullOrEmpty(choice.NextNodeId) && choice.NextNodeId.StartsWith("end_"));

        if (isEnd)
        {
            Nav.NavigateTo("/summary");
        }
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}