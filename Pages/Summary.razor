@page "/summary"
@using System
@using System.Linq
@using SafeZone.Logic
@using SafeZone.Models
@using Microsoft.AspNetCore.Components
@inject GameStateService State
@inject NavigationManager Nav
@inject GameEngine Engine

<div class="game-wrapper">
    <img src="images/start-bg.jpg" class="image-bg" alt="Summary Background" />

    <div class="content-box">
        <h1 class="title">Summary</h1>
        <div class="divider"></div>

        @if (State.ChoiceHistory == null || !State.ChoiceHistory.Any())
        {
            <p class="scenario-text">No actions recorded.</p>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_filterLevel))
            {
                <div class="mb-3 d-flex align-items-center justify-content-center gap-3">
                    <button class="btn-safezone" style="font-size: 1rem;" @onclick="ToggleShowAll">
                        [ @(_showAllLevels ? "Show only this level" : "Show all levels") ]
                    </button>
                </div>
            }

            <div class="summary-list">
                @{
                    var groups = GetGroupedSummaries();
                }
                @if (!groups.Any())
                {
                    <p>No actions recorded for this level.</p>
                }
                else
                {
                    @foreach (var levelGroup in groups)
                    {
                        <div class="level-summary-group">
                            <h3 class="level-title">@levelGroup.Key</h3>
                            <ul class="list-unstyled">
                                @foreach (var entry in levelGroup)
                                {
                                    <li class="mb-1">• @((MarkupString)entry.Text)</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
        }

        <div class="divider" style="width: 100%; opacity: 0.3;"></div>

        <div class="summary-actions d-flex flex-wrap justify-content-center gap-2">
            @if (!string.IsNullOrEmpty(_nextLevelQuery))
            {
                <button class="btn-safezone" @onclick="ContinueToNextLevel">[ Continue to next level ]</button>
            }
            <button class="btn-safezone btn-checkpoint" @onclick="ContinueFromCheckpoint">[ Continue from last checkpoint ]</button>
            <button class="btn-safezone btn-danger" @onclick="ShowConfirm">[ Back to menu ]</button>
        </div>
    </div>
</div>

@if (_showConfirm)
{
    <div class="confirm-backdrop" @onclick="CancelConfirm">
        <div class="content-box modal-danger" @onclick:stopPropagation>
            <h4 class="mb-3" style="color: #ff4444; font-size: 2rem;">Clear progress?</h4>
            <p class="mb-4">This will reset the current game progress and checkpoints. Are you sure you want to continue?</p>
            <div class="d-flex justify-content-center gap-3">
                <button class="btn-safezone" @onclick="CancelConfirm">[ Cancel ]</button>
                <button class="btn-safezone btn-danger" style="background: #ff4444; color: #000;" @onclick="ConfirmBackToMenu">
                    [ Clear & Menu ]
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string? _nextLevelQuery;
    private string? _filterLevel;
    private string? _nextNode;
    private bool _showConfirm;
    private bool _showAllLevels;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var queryString = uri.Query;

        if (!string.IsNullOrEmpty(queryString))
        {
            var pairs = queryString.TrimStart('?')
                                   .Split('&', StringSplitOptions.RemoveEmptyEntries);

            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var p in pairs)
            {
                var kv = p.Split('=', 2);
                var key = Uri.UnescapeDataString(kv[0]);
                var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
                dict[key] = value;
            }

            if (dict.TryGetValue("nextLevel", out var nl) && !string.IsNullOrEmpty(nl))
                _nextLevelQuery = nl;
            if (dict.TryGetValue("nextNode", out var nn) && !string.IsNullOrEmpty(nn))
                _nextNode = nn;

            // Accept showAll=1 or showAll=true to force showing the full history
            if (dict.TryGetValue("showAll", out var sa) &&
                (sa == "1" || sa.Equals("true", StringComparison.OrdinalIgnoreCase)))
            {
                _showAllLevels = true;
                _filterLevel = null; // don't filter when showing everything
            }
        }

        // Default filter: if not showing all, pick last recorded level (most recently completed)
        if (!_showAllLevels)
        {
            if (!string.IsNullOrEmpty(_filterLevel))
            {
                // filter was provided explicitly earlier, keep it
            }
            else if (State.ChoiceHistory != null && State.ChoiceHistory.Any())
            {
                _filterLevel = State.ChoiceHistory.Last().LevelName;
            }
            else
            {
                _filterLevel = State.CurrentLevelName;
            }
        }
    }

    private IEnumerable<IGrouping<string, GameSummaryEntry>> GetGroupedSummaries()
    {
        if (State.ChoiceHistory == null || !State.ChoiceHistory.Any())
            return Enumerable.Empty<IGrouping<string, GameSummaryEntry>>();

        if (!string.IsNullOrEmpty(_filterLevel) && !_showAllLevels)
        {
            return State.ChoiceHistory
                        .Where(e => string.Equals(e.LevelName, _filterLevel, StringComparison.OrdinalIgnoreCase))
                        .GroupBy(e => e.LevelName);
        }

        return State.ChoiceHistory.GroupBy(e => e.LevelName);
    }

    private void ToggleShowAll() => _showAllLevels = !_showAllLevels;

    private async Task ContinueToNextLevel()
    {
        if (string.IsNullOrEmpty(_nextLevelQuery))
        {
            Nav.NavigateTo("/play");
            return;
        }

        await Engine.LoadLevel(_nextLevelQuery);
        if (!string.IsNullOrEmpty(_nextNode))
            State.SetCurrentNode(_nextNode);

        Nav.NavigateTo("/play");
    }

    private void ContinueFromCheckpoint()
    {
        State.ResetToCheckpoint();
        Nav.NavigateTo("/play");
    }

    private void ShowConfirm() => _showConfirm = true;
    private void CancelConfirm() => _showConfirm = false;

    private void ConfirmBackToMenu()
    {
        State.ClearAll();
        _showConfirm = false;
        Nav.NavigateTo("/");
    }
}