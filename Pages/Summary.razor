@page "/summary"
@using System
@using System.Linq
@using SafeZone.Logic
@using SafeZone.Models
@inject GameStateService State
@inject NavigationManager Nav
@inject GameEngine Engine

<div class="summary-page container py-4">
    <h1>Summary</h1>

    @if (State.ChoiceHistory == null || !State.ChoiceHistory.Any())
    {
        <p>No actions recorded.</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_filterLevel))
        {
            <div class="mb-3 d-flex align-items-center">
                <strong class="me-3">Showing:</strong>
                <span class="badge bg-secondary me-auto">@_filterLevel</span>
                <button class="btn btn-sm btn-outline-primary" @onclick="ToggleShowAll">
                    @(_showAllLevels ? "Show only this level" : "Show all levels")
                </button>
            </div>
        }

        var groups = GetGroupedSummaries();
        if (!groups.Any())
        {
            <p>No actions recorded for this level.</p>
        }
        else
        {
            @foreach (var levelGroup in groups)
            {
                <div class="level-summary mb-4">
                    <h3 class="level-name">@levelGroup.Key</h3>
                    <ul class="list-unstyled ms-3">
                        @foreach (var entry in levelGroup)
                        {
                            <li class="mb-1">• @entry.Text</li>
                        }
                    </ul>
                </div>
            }
        }
    }

    <div class="summary-actions mt-3">
        @if (!string.IsNullOrEmpty(_nextLevelQuery))
        {
            <button class="btn btn-primary me-2" @onclick="ContinueToNextLevel">Continue to next level</button>
        }
        <button class="btn btn-secondary me-2" @onclick="ContinueFromCheckpoint">Continue from last checkpoint</button>
        <button class="btn btn-link text-danger" @onclick="ShowConfirm">Back to menu</button>
    </div>
</div>

@if (_showConfirm)
{
    <div class="confirm-backdrop" @onclick="CancelConfirm">
        <div class="confirm-modal" @onclick:stopPropagation>
            <h4 class="mb-3">Clear progress?</h4>
            <p class="mb-4">This will reset the current game progress and checkpoints. Are you sure you want to continue?</p>
            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-outline-secondary" @onclick="CancelConfirm">Cancel</button>
                <button class="btn btn-danger" @onclick="ConfirmBackToMenu">Clear &amp; Menu</button>
            </div>
        </div>
    </div>
}

@code {
    private string? _nextLevelQuery; // upcoming level from query (used for Continue button)
    private string? _filterLevel;    // the level we show summaries for (completed level)
    private string? _nextNode;
    private bool _showConfirm;
    private bool _showAllLevels;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var queryString = uri.Query;

        if (!string.IsNullOrEmpty(queryString))
        {
            var pairs = queryString.TrimStart('?')
                                   .Split('&', StringSplitOptions.RemoveEmptyEntries);

            var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var p in pairs)
            {
                var kv = p.Split('=', 2);
                var key = Uri.UnescapeDataString(kv[0]);
                var value = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : string.Empty;
                dict[key] = value;
            }

            if (dict.TryGetValue("nextLevel", out var nl) && !string.IsNullOrEmpty(nl))
                _nextLevelQuery = nl;
            if (dict.TryGetValue("nextNode", out var nn) && !string.IsNullOrEmpty(nn))
                _nextNode = nn;
        }

        // Default filter behavior:
        // - If we were navigated here before loading the NEXT level (nextLevel present),
        //   show summaries for the level the player just completed (use last recorded entry or State.CurrentLevelName).
        // - Otherwise, default to the most recently recorded level.
        if (!string.IsNullOrEmpty(_nextLevelQuery))
        {
            if (State.ChoiceHistory != null && State.ChoiceHistory.Any())
                _filterLevel = State.ChoiceHistory.Last().LevelName;
            else
                _filterLevel = State.CurrentLevelName;
        }
        else if (State.ChoiceHistory != null && State.ChoiceHistory.Any())
        {
            _filterLevel = State.ChoiceHistory.Last().LevelName;
        }
    }

    private IEnumerable<IGrouping<string, GameSummaryEntry>> GetGroupedSummaries()
    {
        if (State.ChoiceHistory == null || !State.ChoiceHistory.Any())
            return Enumerable.Empty<IGrouping<string, GameSummaryEntry>>();

        if (!string.IsNullOrEmpty(_filterLevel) && !_showAllLevels)
        {
            return State.ChoiceHistory
                        .Where(e => string.Equals(e.LevelName, _filterLevel, StringComparison.OrdinalIgnoreCase))
                        .GroupBy(e => e.LevelName);
        }

        return State.ChoiceHistory.GroupBy(e => e.LevelName);
    }

    private void ToggleShowAll()
    {
        _showAllLevels = !_showAllLevels;
    }

    private async Task ContinueToNextLevel()
    {
        if (string.IsNullOrEmpty(_nextLevelQuery))
        {
            Nav.NavigateTo("/play");
            return;
        }

        await Engine.LoadLevel(_nextLevelQuery);
        if (!string.IsNullOrEmpty(_nextNode))
            State.SetCurrentNode(_nextNode);

        Nav.NavigateTo("/play");
    }

    private void ContinueFromCheckpoint()
    {
        State.ResetToCheckpoint();
        Nav.NavigateTo("/play");
    }

    private void ShowConfirm()
    {
        _showConfirm = true;
    }

    private void CancelConfirm()
    {
        _showConfirm = false;
    }

    private void ConfirmBackToMenu()
    {
        State.ClearAll();
        _showConfirm = false;
        Nav.NavigateTo("/");
    }
}